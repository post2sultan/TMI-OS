APP_ENV=production
API_NAME=TMI API
API_VERSION=0.2.0
LOG_LEVEL=INFO

AUTH_VIEWER_API_KEY=REPLACE_WITH_VIEWER_SECRET
AUTH_OPERATOR_API_KEY=REPLACE_WITH_OPERATOR_SECRET
AUTH_REVIEWER_API_KEY=REPLACE_WITH_REVIEWER_SECRET
AUTH_ADMIN_API_KEY=REPLACE_WITH_ADMIN_SECRET
AUTH_READ_RATE_LIMIT_PER_MINUTE=120
AUTH_WRITE_RATE_LIMIT_PER_MINUTE=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tmi
POSTGRES_USER=tmi
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_SECRET

QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

SEARXNG_URL=http://tmi-searxng:8080
SEARXNG_TIMEOUT=30

SERPER_API_KEY=REPLACE_WITH_SERPER_API_KEY
SERPER_URL=https://google.serper.dev/search
SERPER_TIMEOUT=30

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
